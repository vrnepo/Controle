# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).
#
# IMPORTANTE: este projeto usa contas PRÓPRIAS, separadas das do SICAD —
# outra conta Google, outro projeto no Neon, outro Render, outro GitHub.
# Não reaproveite nenhuma credencial nem nenhum ID do SICAD aqui.

# --- Banco (Neon) — obrigatório
# Painel do Neon → Connection string → "psycopg". Pode colar com o prefixo
# "psql " e com aspas: o core/bd.py normaliza.
DATABASE_URL=

# --- Sessão. Em produção o Render gera sozinho (generateValue: true).
SECRET_KEY=troque-isto-em-producao

# 1 = cookie só por https (Render). Em localhost deixe 0, senão o navegador
# descarta o cookie e o login nunca "pega".
COOKIE_SEGURO=0

# --- Senha dos PDFs de fatura do Santander (é o CPF do titular).
# Sem isso o PDF da fatura não abre — o CSV e o XLSX seguem funcionando.
SENHA_PDF_SANTANDER=

# --- Espelho na planilha do Google (opcional; o sistema roda sem)
# Conteúdo INTEIRO do JSON da conta de serviço, em uma linha só.
GCP_SERVICE_ACCOUNT_JSON=
# Id da planilha espelho (o trecho entre /d/ e /edit na URL).
# A planilha precisa estar compartilhada como EDITOR com o client_email do JSON.
PLANILHA_ESPELHO_ID=
